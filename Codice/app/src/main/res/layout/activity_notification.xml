<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blu"
    tools:context=".views.activity.NotificationActivity">


    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="57dp"
        android:layout_height="57dp"
        android:background="@drawable/custom_botton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.033"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.117"
        app:srcCompat="@drawable/ic_back" />

    <TextView
        android:id="@+id/Name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="128dp"
        android:gravity="center"
        android:text="@string/activity_notification_name"
        android:visibility="gone"
        android:textColor="@color/white"
        android:textSize="50dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView_activity_notification_description"
        android:layout_width="810dp"
        android:layout_height="315dp"
        android:background="@color/blu"
        app:cardCornerRadius="40dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F310174E">

            <TextView
                android:id="@+id/notification_text"
                android:layout_width="659dp"
                android:layout_height="208dp"
                android:gravity="center"
                android:text="@string/activity_notification_descriptionActivity"
                android:textColor="#B8170B"
                android:textSize="40dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.503"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.495" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/linearLayout_activityNotification_btn"
        android:layout_width="625dp"
        android:layout_height="122dp"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/cardView_activity_notification_description"
        app:layout_constraintHorizontal_bias="0.502"
        app:layout_constraintStart_toStartOf="@+id/cardView_activity_notification_description"
        app:layout_constraintTop_toBottomOf="@+id/cardView_activity_notification_description"
        tools:ignore="MissingConstraints">

        <Button
            android:id="@+id/activity_notification_btnConfirm"
            style="?android:attr/buttonBarStyle"
            android:layout_width="272dp"
            android:layout_height="71dp"
            android:layout_margin="20dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="151dp"
            android:layout_marginBottom="140dp"
            android:background="@drawable/custom_botton"
            android:gravity="center"
            android:text="@string/fragment_activity_confirm"
            android:textAllCaps="false"
            android:textColor="@color/green"
            android:textIsSelectable="false"
            android:textSize="16sp"
            android:textStyle="normal"
            app:backgroundTint="@color/green"
            app:cornerRadius="25dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.063"
            app:layout_constraintStart_toStartOf="@+id/cardView_activity_notification_description"
            app:layout_constraintTop_toBottomOf="@+id/cardView_activity_notification_description"
            app:layout_constraintVertical_bias="0.55"
            tools:ignore="MissingConstraints" />

        <Button
            android:id="@+id/activity_notification_goToHomeBaseButton"
            style="?android:attr/buttonBarStyle"
            android:layout_width="272dp"
            android:layout_height="71dp"
            android:layout_margin="20dp"
            android:layout_marginBottom="120dp"
            android:background="@drawable/custom_botton"
            android:gravity="center"
            android:text="@string/fragment_activity_oToHomeBaseButton"
            android:textAllCaps="false"
            android:textColor="@color/green"
            android:textIsSelectable="false"
            android:textSize="16sp"
            android:textStyle="normal"
            app:backgroundTint="@color/green"
            app:cornerRadius="25dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.497"
            app:layout_constraintStart_toStartOf="@+id/activity_notification_btnConferm"
            app:layout_constraintTop_toBottomOf="@+id/cardView_activity_notification_description"
            app:layout_constraintVertical_bias="0.411"
            tools:ignore="MissingConstraints" />

    </LinearLayout>


    <TextView
        android:id="@+id/FaceRecognition"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="164dp"
        android:gravity="center"
        android:text="@string/fragment_activity_notification_recognition"
        android:textColor="@color/white"
        android:textSize="50dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.501"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/addImageFace"
        android:layout_width="440dp"
        android:layout_height="401dp"
        android:src="@drawable/ic_image_box"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.676" />

    <Button
        android:id="@+id/fragment_create_route_button_sava"
        style="?android:attr/buttonBarStyle"
        android:layout_width="216dp"
        android:layout_height="57dp"
        android:layout_margin="20dp"
        android:background="@drawable/custom_botton"
        android:gravity="center"
        android:text="@string/fragment_activity_notification_verify"
        android:textAllCaps="false"
        android:textColor="@color/green"
        android:textIsSelectable="false"
        android:textSize="20sp"
        android:textStyle="normal"
        app:backgroundTint="@color/green"
        app:cornerRadius="25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.955" />


</androidx.constraintlayout.widget.ConstraintLayout>