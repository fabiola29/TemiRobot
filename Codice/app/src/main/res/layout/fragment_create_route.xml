<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".views.fragment.CreateRouteFragment"
    android:clickable="true"
    android:focusable="true"
    android:background="@color/blu"
    android:focusableInTouchMode="true"
    android:id="@+id/createRouteFrameLayout">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/createRouteParentLayout"
        android:layout_width="match_parent"
        android:layout_height="800dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="57dp"
            android:layout_height="57dp"
            android:background="@drawable/custom_botton"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.033"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.117"
            app:srcCompat="@drawable/ic_back" />

        <TextView
            android:id="@+id/routeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="76dp"
            android:gravity="center"
            android:text="@string/fragment_create_route_routeName"
            android:textColor="@color/white"
            android:textSize="50dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/fragment_create_route_text_input_location_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.Long"
            android:layout_width="1191dp"
            android:layout_height="86dp"
            android:layout_margin="5dp"
            android:backgroundTint="@color/green"
            android:hint="@string/fragment_create_route_nameItinerary"
            android:textColorHint="@color/green"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="@color/white"
            app:endIconMode="clear_text"
            app:endIconTint="@color/green"
            app:hintTextColor="@color/green"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.505"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.229"
            app:startIconDrawable="@drawable/ic_location"
            app:startIconTint="@color/green"
            tools:ignore="MissingConstraints">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/fragment_create_route_text_input_location"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textColorHint="@color/green"
                android:textCursorDrawable="@null"
                android:textSize="20dp"/>

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/patrolCountTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="332dp"
            android:text="@string/fragment_create_route_patrolCount"
            android:textColor="@color/green"
            android:textSize="30sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.04"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.ramotion.fluidslider.FluidSlider
            android:id="@+id/patrolCountSlider"
            android:layout_width="795dp"
            android:layout_height="135dp"
            android:layout_marginTop="240dp"
            android:layout_marginEnd="16dp"
            android:elevation="2dp"
            app:bar_color="#5B6BC6"
            app:duration="@android:integer/config_mediumAnimTime"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.571"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:size="normal"
            app:text_size="20dp"
            tools:targetApi="lollipop" />

        <TextView
            android:id="@+id/routeTitleTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="420dp"
            android:text="@string/fragment_create_route_routeTitle"
            android:textColor="@color/green"
            android:textSize="30sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.063"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/createRouteRv"
            android:layout_width="790dp"
            android:layout_height="164dp"
            android:layout_marginTop="420dp"
            android:overScrollMode="never"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.557"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/locationsTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="612dp"
            android:text="@string/fragment_create_route_locations"
            android:textColor="@color/green"
            android:textSize="30sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.015"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/locationsRv"
            android:layout_width="795dp"
            android:layout_height="175dp"
            android:layout_marginTop="608dp"
            android:overScrollMode="never"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.562"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/fragment_create_route_button_sava"
            style="?android:attr/buttonBarStyle"
            android:layout_width="171dp"
            android:layout_height="66dp"
            android:layout_margin="20dp"
            android:layout_marginStart="39dp"
            android:layout_marginEnd="36dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/custom_botton"
            android:gravity="center"
            android:text="@string/fragment_create_route_btn_save"
            android:textAllCaps="false"
            android:textColor="@color/green"
            android:textIsSelectable="false"
            android:textSize="20sp"
            android:textStyle="normal"
            app:backgroundTint="@color/green"
            app:cornerRadius="25dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.411"
            app:layout_constraintStart_toEndOf="@+id/locationsRv"
            app:layout_constraintTop_toBottomOf="@+id/fragment_create_route_button_continuos_patrol"
            app:layout_constraintVertical_bias="0.937" />

        <Button
            android:id="@+id/fragment_create_route_button_continuos_patrol"
            style="?android:attr/buttonBarStyle"
            android:layout_width="171dp"
            android:layout_height="66dp"
            android:layout_margin="20dp"
            android:layout_marginStart="77dp"
            android:layout_marginTop="60dp"
            android:background="@drawable/custom_botton"
            android:gravity="center"
            android:text="@string/fragment_create_route_btn_continuous_patrol"
            android:textAllCaps="false"
            android:textColor="@color/green"
            android:textIsSelectable="false"
            android:textSize="16sp"
            android:textStyle="normal"
            app:backgroundTint="@color/green"
            app:cornerRadius="25dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toEndOf="@+id/patrolCountSlider"
            app:layout_constraintTop_toBottomOf="@+id/fragment_create_route_text_input_location_layout"
            app:layout_constraintVertical_bias="0.078"
            tools:ignore="MissingConstraints" />

        <ImageButton
            android:id="@+id/btn_help"
            android:layout_width="57dp"
            android:layout_height="57dp"
            android:background="@drawable/custom_botton"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.982"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.117"
            app:srcCompat="@drawable/ic_question"  />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>