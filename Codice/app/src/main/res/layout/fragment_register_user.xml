<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".views.fragment.ActivityFragment"
    android:clickable="true"
    android:focusable="true"
    android:background="@color/blu"
    android:focusableInTouchMode="true"
    android:id="@+id/fragment_registerUserFrameLayout">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/createRouteParentLayout"
        android:layout_width="match_parent"
        android:layout_height="800dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="57dp"
            android:layout_height="57dp"
            android:background="@drawable/custom_botton"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.033"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.117"
            app:srcCompat="@drawable/ic_back" />


        <TextView
            android:id="@+id/Name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="96dp"
            android:gravity="center"
            android:text="@string/fragment_login_user_namePages"
            android:textColor="@color/white"
            android:textSize="50dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/addImageFace"
            android:layout_width="248dp"
            android:layout_height="232dp"
            android:src="@drawable/ic_image_box"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.163"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.941" />

        <TextView
            android:id="@+id/face"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="116dp"
            android:text="@string/fragment_register_user_face"
            android:textColor="@color/green"
            android:textSize="40sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.046"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fragment_insert_activity_linearLayout"
            tools:ignore="MissingConstraints" />

        <Button
            android:id="@+id/fragment_create_route_button_sava"
            style="?android:attr/buttonBarStyle"
            android:layout_width="174dp"
            android:layout_height="54dp"
            android:layout_margin="20dp"
            android:layout_marginEnd="48dp"
            android:layout_marginBottom="44dp"
            android:background="@drawable/custom_botton"
            android:gravity="center"
            android:text="@string/fragment_register_user_saveBtn"
            android:textAllCaps="false"
            android:textColor="@color/green"
            android:textIsSelectable="false"
            android:textSize="20sp"
            android:textStyle="normal"
            app:backgroundTint="@color/green"
            app:cornerRadius="25dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fragment_insert_activity_linearLayout"
            app:layout_constraintVertical_bias="1.0" />

        <ImageButton
            android:id="@+id/btn_help"
            android:layout_width="57dp"
            android:layout_height="57dp"
            android:background="@drawable/custom_botton"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.983"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.117"
            app:srcCompat="@drawable/ic_question" />

        <LinearLayout
            android:id="@+id/fragment_insert_activity_linearLayout"
            android:layout_width="1186dp"
            android:layout_height="315dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.595"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.383">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/fragment_insert_activity_text_input_layout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.Long"
                android:layout_width="1161dp"
                android:layout_height="91dp"
                android:layout_margin="5dp"
                android:layout_marginStart="5dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="20dp"
                android:backgroundTint="@color/green"
                android:hint="@string/fragment_register_user_nameUser"
                android:textColorHint="@color/green"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/white"
                app:endIconMode="clear_text"
                app:endIconTint="@color/green"
                app:hintTextColor="@color/green"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.049"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.238"
                app:startIconDrawable="@drawable/ic_user"
                app:startIconTint="@color/green"
                tools:ignore="MissingConstraints">


                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/fragment_insert_activity_text_input"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textColorHint="@color/green"
                    android:textCursorDrawable="@null"
                    android:textSize="20dp" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/fragment_insert_activity_text_input_layout_emailActivity"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.Long"
                android:layout_width="1161dp"
                android:layout_height="91dp"
                android:layout_margin="5dp"
                android:layout_marginStart="20dp"
                android:backgroundTint="@color/green"
                android:hint="@string/fragment_register_user_emailUser"
                android:textColorHint="@color/green"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/white"
                app:endIconMode="clear_text"
                app:endIconTint="@color/green"
                app:hintTextColor="@color/green"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.271"
                app:layout_constraintStart_toEndOf="@+id/fragment_insert_activity_text_input_layout"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.245"
                app:startIconDrawable="@drawable/ic_activity"
                app:startIconTint="@color/green"
                tools:ignore="MissingConstraints">


                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/fragment_insert_activity_text_input_emailActivity"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textColorHint="@color/green"
                    android:textCursorDrawable="@null"
                    android:textSize="20dp" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/fragment_insert_activity_text_input_layout_passwordActivity"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.Long"
                android:layout_width="1161dp"
                android:layout_height="91dp"
                android:layout_margin="5dp"
                android:layout_marginStart="20dp"
                android:backgroundTint="@color/green"
                android:hint="@string/fragment_register_user_passwordUser"
                android:textColorHint="@color/green"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/white"
                app:endIconTint="@color/green"
                app:hintTextColor="@color/green"
                app:endIconMode="password_toggle"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.271"
                app:layout_constraintStart_toEndOf="@+id/fragment_insert_activity_text_input_layout"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.245"
                app:startIconDrawable="@drawable/ic_lock"
                app:startIconTint="@color/green"
                tools:ignore="MissingConstraints">


                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/fragment_insert_activity_text_input_passwordActivity"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textColorHint="@color/green"
                    android:textCursorDrawable="@null"
                    android:textSize="20dp" />

            </com.google.android.material.textfield.TextInputLayout>


        </LinearLayout>

        <TextView
            android:id="@+id/textView4"
            android:layout_width="519dp"
            android:layout_height="58dp"
            android:layout_marginTop="172dp"
            android:text="@string/fragment_register_user_msgPhoto"
            android:textColor="@color/red"
            android:textSize="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.561"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/addImageFace"
            app:layout_constraintVertical_bias="0.055"
            tools:ignore="MissingConstraints" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
