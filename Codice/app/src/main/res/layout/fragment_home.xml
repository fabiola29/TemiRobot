<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blu"
    android:orientation="vertical"
    android:id="@id/HomeFragment">

    <!-- vertical ScrollView to make all the items or views scrollable -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="vertical">

        <!-- LinearLayout Inside ScrollView -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="800dp">

                <TextView
                    android:id="@+id/fragment_activity_textView_nameRobot"
                    android:layout_width="382dp"
                    android:layout_height="87dp"
                    android:gravity="center"
                    android:text="@string/fragment_home_activity_name"
                    android:textColor="@color/white"
                    android:textSize="40sp"
                    android:textStyle="normal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.217"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.138"
                    tools:ignore="MissingConstraints" />

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="390dp"
                    android:layout_height="479dp"
                    android:layout_marginStart="792dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.785"
                    app:srcCompat="@drawable/icon1" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardView_create_route"
                    android:layout_width="634dp"
                    android:layout_height="108dp"
                    android:layout_marginTop="30dp"
                    android:background="@color/blu"
                    app:layout_constraintEnd_toEndOf="@+id/fragment_activity_textView_nameRobot"
                    app:layout_constraintStart_toStartOf="@+id/fragment_activity_textView_nameRobot"
                    app:layout_constraintTop_toBottomOf="@+id/fragment_activity_textView_nameRobot">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="108dp"
                        android:background="#F310174E">

                        <TextView
                            android:layout_width="342dp"
                            android:layout_height="73dp"
                            android:gravity="center"
                            android:text="@string/fragment_home_bnt_create_route"
                            android:textColor="@color/green"
                            android:textSize="40dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/imageView"
                            app:layout_constraintHorizontal_bias="0.54"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_bias="0.542" />

                        <ImageView
                            android:id="@+id/imageView"
                            android:layout_width="112dp"
                            android:layout_height="82dp"
                            android:layout_marginEnd="32dp"
                            android:src="@drawable/ic_add_route_icon"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_bias="0.615"
                            tools:ignore="DuplicateIds" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardView_start_patrol"
                    android:layout_width="634dp"
                    android:layout_height="108dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="30dp"
                    android:background="@color/blu"
                    app:layout_constraintEnd_toEndOf="@+id/cardView_create_route"
                    app:layout_constraintStart_toStartOf="@+id/cardView_create_route"
                    app:layout_constraintTop_toBottomOf="@+id/cardView_create_route"
                    tools:ignore="MissingConstraints">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#F310174E">

                        <TextView
                            android:layout_width="337dp"
                            android:layout_height="76dp"
                            android:gravity="center"
                            android:text="@string/fragment_home_bnt_start_patrol"
                            android:textColor="@color/green"
                            android:textSize="40dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/imageView2"
                            app:layout_constraintHorizontal_bias="0.609"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/imageView2"
                            android:layout_width="170dp"
                            android:layout_height="106dp"
                            android:layout_marginEnd="4dp"
                            android:src="@drawable/ic_patrol_icon"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_bias="0.0" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardView_option_location"
                    android:layout_width="634dp"
                    android:layout_height="108dp"
                    android:layout_marginTop="30dp"
                    android:background="@color/blu"
                    app:layout_constraintEnd_toEndOf="@+id/cardView_start_patrol"
                    app:layout_constraintStart_toStartOf="@+id/cardView_start_patrol"
                    app:layout_constraintTop_toBottomOf="@+id/cardView_start_patrol"
                    tools:ignore="MissingConstraints">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#F310174E">

                        <TextView
                            android:layout_width="395dp"
                            android:layout_height="95dp"
                            android:gravity="center"
                            android:text="@string/fragment_home_bnt_option_location"
                            android:textColor="@color/green"
                            android:textSize="35dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/imageView3"
                            app:layout_constraintHorizontal_bias="0.427"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_bias="0.307" />

                        <ImageView
                            android:id="@+id/imageView3"
                            android:layout_width="59dp"
                            android:layout_height="42dp"
                            android:layout_marginEnd="64dp"
                            android:src="@drawable/ic_add_location"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_bias="0.06" />

                        <ImageView
                            android:id="@+id/imageView4"
                            android:layout_width="59dp"
                            android:layout_height="42dp"
                            android:layout_marginEnd="64dp"
                            android:src="@drawable/ic_remove_location"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_bias="0.863" />

                        <ImageView
                            android:id="@+id/imageView5"
                            android:layout_width="59dp"
                            android:layout_height="42dp"
                            android:layout_marginEnd="16dp"
                            android:src="@drawable/ic_edit_location"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardView_option_activity"
                    android:layout_width="634dp"
                    android:layout_height="108dp"
                    android:layout_marginTop="30dp"
                    android:background="@color/blu"
                    app:layout_constraintEnd_toEndOf="@+id/cardView_option_location"
                    app:layout_constraintStart_toStartOf="@+id/cardView_option_location"
                    app:layout_constraintTop_toBottomOf="@+id/cardView_option_location"
                    tools:ignore="MissingConstraints">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#F310174E">

                        <TextView
                            android:layout_width="395dp"
                            android:layout_height="95dp"
                            android:gravity="center"
                            android:text="@string/fragment_home_bnt_option_scheduler"
                            android:textColor="@color/green"
                            android:textSize="35dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/imageView6"
                            app:layout_constraintHorizontal_bias="0.424"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_bias="0.692" />

                        <ImageView
                            android:id="@+id/imageView6"
                            android:layout_width="89dp"
                            android:layout_height="90dp"
                            android:layout_marginEnd="44dp"
                            android:src="@drawable/ic_scheduler"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />


                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.cardview.widget.CardView>


                <ImageButton
                    android:id="@+id/btn_logout"
                    android:layout_width="57dp"
                    android:layout_height="57dp"
                    android:background="@drawable/custom_botton"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.984"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.117"
                    app:srcCompat="@drawable/logout" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>