<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:padding="10dp"
    android:clipToPadding="false"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:id="@+id/routeCard"
        android:layout_width="869dp"
        android:layout_height="184dp"
        app:cardCornerRadius="30dp"
        app:cardElevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F310174E"
            android:clipToPadding="false">

            <TextView
                android:id="@+id/taskListTitleTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="40px"
                android:text="@string/tasks_execution_card_item_name_tasks"
                android:textColor="@color/white"
                android:textSize="50dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/taskListIcon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0" />


            <TextView
                android:id="@+id/taskListDayTv"
                android:layout_width="92dp"
                android:layout_height="31dp"
                android:layout_marginEnd="268dp"
                android:text="@string/tasks_execution_card_item_day_tasks"
                android:textColor="@color/white"
                android:textSize="24dp"
                app:layout_constraintBottom_toTopOf="@+id/taskListTimeTv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toEndOf="@+id/taskListTitleTv"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.984" />

            <TextView
                android:id="@+id/taskTimeTv"
                android:layout_width="136dp"
                android:layout_height="44dp"
                android:paddingLeft="20dp"
                android:text="@string/tasks_execution_card_item_taskTimeTv"
                android:textColor="@color/white"
                android:textSize="30dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toEndOf="@+id/taskListIcon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.678" />

            <TextView
                android:id="@+id/taskListTimeTv"
                android:layout_width="540dp"
                android:layout_height="43dp"
                android:paddingLeft="20dp"
                android:text="@string/tasks_execution_card_item_time_tasks"
                android:textColor="@color/white"
                android:textSize="30dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.517"
                app:layout_constraintStart_toEndOf="@+id/taskListIcon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.68" />


            <TextView
                android:id="@+id/taskLocationTv"
                android:layout_width="184dp"
                android:layout_height="43dp"
                android:paddingLeft="20dp"
                android:text="@string/tasks_execution_card_item_Location_tasks"
                android:textColor="@color/white"
                android:textSize="30dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toEndOf="@+id/taskListIcon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.985" />

            <TextView
                android:id="@+id/taskListLocationTv"
                android:layout_width="405dp"
                android:layout_height="46dp"
                android:paddingLeft="20dp"
                android:text="@string/tasks_execution_card_item_taskListLocationTv"
                android:textColor="@color/white"
                android:textSize="30dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.462"
                app:layout_constraintStart_toEndOf="@+id/taskListIcon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="1.0" />

            <ImageView
                android:id="@+id/taskListIcon"
                android:layout_width="140dp"
                android:layout_height="143dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.021"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.372"
                app:srcCompat="@drawable/notification" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>